# Application Configuration
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Database Credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL (for Docker use host 'db', for local host use 'localhost')
DATABASE_URL=

# Security and JWT
SECRET_KEY=
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
